# Copie para .env (na raiz do monorepo). O .env nunca vai para o git.

# --- Banco de dados ---
# Local: Postgres embutido (pnpm db:start) na porta 5433.
# Produção: connection strings do Neon (papel da aplicação e papel dono).
# Conexão da aplicação: papel zaraki_app (sujeito a RLS, sem DELETE).
DATABASE_URL=postgres://zaraki_app:zaraki_app_dev@localhost:5433/zaraki
# Conexão usada só para migrations (papel dono do banco).
DATABASE_URL_MIGRATIONS=postgres://postgres:postgres@localhost:5433/zaraki
# Senha definida para o papel zaraki_app ao rodar as migrations (deve bater com DATABASE_URL).
APP_DB_PASSWORD=zaraki_app_dev

# --- Negócio ---
# Unidade que recebe os pedidos do site.
DEFAULT_TENANT_SLUG=matriz
# Número que recebe os pedidos no WhatsApp (só dígitos, com DDI e DDD).
WHATSAPP_NUMBER=5562981092799

# --- Autenticação do admin (Better Auth) ---
# Segredo para assinar sessões: gere com `openssl rand -base64 32` (um diferente por ambiente).
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio
# Endereço público do site (em produção, o domínio real com https).
BETTER_AUTH_URL=http://localhost:3000

# --- Google Agenda (encomendas e festas) ---
# Conta de serviço com acesso à agenda (passo a passo em docs/google-agenda.md).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada da conta de serviço (campo "private_key" do JSON, com \n literais).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Agenda padrão da rede (cada unidade pode ter a sua no cadastro de Unidades).
GOOGLE_CALENDAR_ID=zarakisushigo@gmail.com
# Só para desenvolvimento offline: "fake" usa uma agenda simulada em memória.
# Em produção deixe vazio: sem credenciais, as encomendas ficam "pendentes" (nunca fingem sincronizar).
CALENDAR_DRIVER=
# Segredo da rota de cron (/api/cron/calendar); a Vercel o envia automaticamente.
CRON_SECRET=troque-por-um-segredo-aleatorio

# --- Fotos do cardápio ---
# Token do Vercel Blob (Storage → Blob na Vercel). Sem ele, o envio de fotos só funciona em desenvolvimento.
BLOB_READ_WRITE_TOKEN=
